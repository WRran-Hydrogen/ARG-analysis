# Machine-specific tool locations for scripts 01-09.
# Copy this file to config/local.env (git-ignored) and edit as needed.
# Any value can also be supplied as an environment variable of the same name.
# Leave a value empty to use the command found on PATH.

# Python inside WSL/Linux with numpy, pandas, scipy, ete4, matplotlib installed
SBL_WSL_PYTHON=python3

# Directory containing the MEME Suite binaries (meme, fimo)
SBL_MEME_BIN_DIR=

# MUSCLE v5 executable
SBL_MUSCLE=muscle

# 1 = run Linux tools through `wsl -e` (Windows host); 0 = run them directly (Linux/macOS)
# Defaults to 1 on Windows and 0 elsewhere.
# SBL_USE_WSL=1
