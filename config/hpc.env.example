# Paths for scripts/hpc_reanalysis/ on a Slurm cluster.
# Copy to config/hpc.env (git-ignored) or to scripts/hpc_reanalysis/hpc.env and edit.
# Every value can also be exported as an environment variable.

# Working root of the re-analysis (01_curated_datasets/, 01b_bacterial_ref_db/, 02_genomic_context/ ...)
SBL_HPC_BASE=/path/to/sbl_reanalysis
# Pfam-A.hmm and Pfam-A.clans.tsv
SBL_HPC_DB_DIR=/path/to/sbl_db
# MOSAiC inputs: mosaic_virus.faa, mosaic_virus_pf00144.faa, sbl_mosaic.tsv, vir.info, euk_info.tsv
SBL_HPC_RAW_INPUT_DIR=/path/to/raw_inputs
# Marine MAG collection (best_genomes_quals.csv, sbl_faa/, sbl_fna/, plasmid_search_genomad/)
SBL_HPC_MARINE_MAGS_DIR=/path/to/marine_mags

# Outputs of upstream jobs
SBL_HPC_GENOMAD_DIR=/path/to/jobs/genomad          # sbl_contigs_virus_summary.tsv.gz, genomad_out/
SBL_HPC_PRODIGAL_DIR=/path/to/jobs/prodigal        # sbl_contigs.fna, all_orfs.faa, orf/*.fna
SBL_HPC_VIRAL_PFAM_DIR=/path/to/jobs/viral_pfam    # sbl_proteins.faa, sbl_proteins_pfam.domtbl.gz
SBL_HPC_STEP1_DIR=/path/to/jobs/step1              # step1_idmap.csv, step1_pfam.domtbl.gz
SBL_HPC_ORFS_PFAM_DIR=/path/to/jobs/orfs_pfam      # orfs_pfam.domtbl
SBL_HPC_EGGNOG_DIR=/path/to/jobs/eggnog            # sbl_neighbourhood.emapper.annotations.gz

# Tools (leave empty to use PATH)
SBL_HPC_MEME_BIN_DIR=
SBL_HPC_HMMSEARCH=hmmsearch
SBL_HPC_MMSEQS=mmseqs
SBL_HPC_PYTHON=python

# Phase 3 (alignment & trees)
SBL_HPC_HMMALIGN=hmmalign
SBL_HPC_MAFFT=mafft
SBL_HPC_CLIPKIT=clipkit
SBL_HPC_IQTREE=iqtree2      # IQ-TREE >= 2.4.0
